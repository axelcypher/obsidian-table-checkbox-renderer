{
  "name": "axlc-table-checkbox-renderer-revamped",
  "version": "1.1.0",
  "private": true,
  "description": "Interactive checkboxes for Markdown tables in Reading View and Live Preview. Toggling updates the Markdown file. Private revamp of Table Checkbox Renderer by Daniel Aguerrevere.",
  "main": "main.js",
  "types": "types/index.d.ts",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:obsidian --external:@codemirror/view --external:@codemirror/state --outfile=main.js --sourcemap",
    "types": "tsc --emitDeclarationOnly --declaration --declarationDir types",
    "build:all": "npm run build && npm run types",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.8",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "obsidian": "*"
  },
  "author": "axelcypher",
  "repository": {
    "type": "git",
    "url": "https://github.com/axelcypher/obsidian-table-checkbox-renderer.git"
  }
}
